<Page
    x:Class="Xmana.App.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:branding="using:Xmana.App.Branding"
    Background="{ThemeResource XmanaBackgroundBrush}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid x:Name="LayoutRoot" XYFocusKeyboardNavigation="Enabled">

        <!-- Application shell: a compact top navigation header + content below it. Padding = TV safe area. -->
        <!-- UserControl (not Grid): Grid is not a Control and has no IsEnabled. Disabled during the splash so nothing can take focus. -->
        <UserControl x:Name="ShellContent"
                     Padding="{ThemeResource XmanaSafeAreaThickness}"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     IsEnabled="False">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: wordmark + horizontal tabs. Compact; never a permanent sidebar/column reservation. -->
            <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <branding:WordmarkView x:Name="RailLogo"
                                       Grid.Column="0"
                                       Variant="Compact"
                                       Height="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,32,0" />

                <StackPanel x:Name="RailItems"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center" />
            </Grid>

            <Frame x:Name="ContentFrame"
                   Grid.Row="1"
                   IsTabStop="False"
                   IsNavigationStackEnabled="False" />
          </Grid>
        </UserControl>

        <!-- Splash: solid black + centred wordmark, continuous with the system splash; one short fade-out. -->
        <Grid x:Name="SplashOverlay" Background="{ThemeResource XmanaBrandBlackBrush}">
            <branding:WordmarkView Variant="Full"
                                   Width="285"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
