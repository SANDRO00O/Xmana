<Page
    x:Class="Xmana.App.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xmana="using:Xmana.App"
    FlowDirection="LeftToRight"
    Background="Black">

    <Page.Resources>
        <Storyboard x:Name="FadeIn">
            <DoubleAnimation Storyboard.TargetName="Wordmark" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Solid black + centered wordmark; kept inside the title-safe area. -->
        <Viewbox MaxWidth="480" Margin="48,27" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="Wordmark"
                       Style="{StaticResource WordmarkFullStyle}"
                       xmana:Loc.Key="app.name"
                       Opacity="0"
                       AutomationProperties.AccessibilityView="Raw" />
        </Viewbox>
    </Grid>
</Page>
