<Page
    x:Class="Xmana.App.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xmana="using:Xmana.App">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Spacing="12">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
        <TextBlock Style="{StaticResource BodyTextStyle}" TextAlignment="Center"
                   xmana:Loc.Key="section.building" />
    </StackPanel>
</Page>
