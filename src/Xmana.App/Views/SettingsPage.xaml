<Page
    x:Class="Xmana.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xmana="using:Xmana.App">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" IsTabStop="False">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="28" Margin="0,8,0,24">
            <TextBlock Style="{StaticResource PageTitleStyle}" xmana:Loc.Key="settings.title" />

            <!-- Interface -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionHeadingStyle}" xmana:Loc.Key="settings.interface" />
                <TextBlock Style="{StaticResource BodyTextStyle}" xmana:Loc.Key="settings.language" />
                <StackPanel x:Name="LanguagePanel" Orientation="Horizontal">
                    <RadioButton x:Name="EnglishChoice" Style="{StaticResource ChoiceButtonStyle}"
                                 GroupName="XmanaLanguage" Tag="en"
                                 xmana:Loc.Key="settings.language.en" Click="OnLanguageClick" />
                    <RadioButton x:Name="ArabicChoice" Style="{StaticResource ChoiceButtonStyle}"
                                 GroupName="XmanaLanguage" Tag="ar"
                                 xmana:Loc.Key="settings.language.ar" Click="OnLanguageClick" />
                </StackPanel>
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionHeadingStyle}" xmana:Loc.Key="settings.about" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource BodyTextStyle}" xmana:Loc.Key="settings.version" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource XmanaTextPrimaryBrush}" FlowDirection="LeftToRight" />
                </StackPanel>
                <TextBlock Style="{StaticResource SectionHeadingStyle}" FontSize="20" xmana:Loc.Key="settings.legal" />
                <TextBlock Style="{StaticResource BodyTextStyle}" xmana:Loc.Key="settings.attribution" />
                <TextBlock Style="{StaticResource BodyTextStyle}" xmana:Loc.Key="app.unofficial" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
