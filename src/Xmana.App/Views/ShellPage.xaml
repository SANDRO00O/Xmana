<Page
    x:Class="Xmana.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xmana="using:Xmana.App"
    Background="{StaticResource XmanaBackgroundBrush}">

    <!-- 48,27 = 5% title-safe margins at 960x540 effective pixels (TV overscan safe) -->
    <Grid Margin="48,27,48,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top navigation: compact wordmark + horizontal tabs -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource WordmarkCompactStyle}"
                       xmana:Loc.Key="app.name"
                       VerticalAlignment="Center"
                       Margin="0,0,32,0"
                       AutomationProperties.AccessibilityView="Raw" />

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          IsTabStop="False">
                <StackPanel x:Name="NavPanel" Orientation="Horizontal" />
            </ScrollViewer>
        </Grid>

        <!-- Section content -->
        <Frame x:Name="ContentFrame" Grid.Row="1" IsNavigationStackEnabled="True" />

        <!-- Localized controller hints -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" Spacing="28"
                    AutomationProperties.AccessibilityView="Raw">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadgeStyle}">
                    <TextBlock Style="{StaticResource HintBadgeTextStyle}" Text="A" />
                </Border>
                <TextBlock Style="{StaticResource HintTextStyle}" xmana:Loc.Key="hint.select" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadgeStyle}">
                    <TextBlock Style="{StaticResource HintBadgeTextStyle}" Text="B" />
                </Border>
                <TextBlock Style="{StaticResource HintTextStyle}" xmana:Loc.Key="hint.back" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadgeStyle}">
                    <TextBlock Style="{StaticResource HintBadgeTextStyle}" Text="LB / RB" />
                </Border>
                <TextBlock Style="{StaticResource HintTextStyle}" xmana:Loc.Key="hint.switchSection" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
