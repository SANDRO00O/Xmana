<Page
    x:Class="Xmana.App.Pages.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls">

    <Grid>
        <ScrollViewer x:Name="Scroller"
                      IsTabStop="False"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      Visibility="Collapsed">
            <StackPanel Spacing="16" Margin="0,0,0,40">
                <TextBlock x:Name="OfflineNotice"
                           Style="{ThemeResource XmanaCaptionTextStyle}"
                           Visibility="Collapsed" />

                <!-- Header: poster + information -->
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="190" Height="285" VerticalAlignment="Top">
                        <Border Background="{ThemeResource XmanaSurfaceRaisedBrush}" CornerRadius="8" />
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush x:Name="PosterBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="TitleText"
                                   Style="{ThemeResource XmanaDisplayTextStyle}"
                                   FontSize="32"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="EpisodeLineText"
                                   Style="{ThemeResource XmanaSecondaryTextStyle}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="OtherTitleText"
                                   Style="{ThemeResource XmanaCaptionTextStyle}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="MetaText"
                                   Style="{ThemeResource XmanaBodyTextStyle}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="CategoriesText"
                                   Style="{ThemeResource XmanaSecondaryTextStyle}"
                                   FontSize="16"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="LanguageText"
                                   Style="{ThemeResource XmanaSecondaryTextStyle}"
                                   FontSize="16"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="DescriptionText"
                                   Style="{ThemeResource XmanaSecondaryTextStyle}"
                                   FontSize="16"
                                   MaxLines="6"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />

                        <controls:ChoiceButton x:Name="PlayButton"
                                               Width="190"
                                               HorizontalAlignment="Left"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed"
                                               Click="OnPlayClick" />

                        <StackPanel x:Name="LibraryPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <controls:ChoiceButton x:Name="FavoriteButton" Width="196" Click="OnFavoriteClick" />
                            <controls:ChoiceButton x:Name="WatchlistButton" Width="196" Click="OnWatchlistClick" />
                        </StackPanel>

                        <StackPanel x:Name="ActionsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <controls:ChoiceButton x:Name="PreviousButton" Width="210" Click="OnPreviousClick" />
                            <controls:ChoiceButton x:Name="NextButton" Width="210" Click="OnNextClick" />
                            <controls:ChoiceButton x:Name="SeriesButton" Width="190" Click="OnSeriesClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Seasons and episodes -->
                <StackPanel x:Name="SeriesSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="EpisodesHeader" Style="{ThemeResource XmanaTitleTextStyle}" FontSize="22" />
                    <ComboBox x:Name="SeasonBox" Width="240" SelectionChanged="OnSeasonChanged" />
                    <StackPanel x:Name="EpisodesPanel" Spacing="4" />
                    <TextBlock x:Name="SeriesMessage" Style="{ThemeResource XmanaSecondaryTextStyle}" Visibility="Collapsed" />
                    <controls:ChoiceButton x:Name="SeriesRetryButton"
                                           Width="200"
                                           HorizontalAlignment="Left"
                                           Visibility="Collapsed"
                                           Click="OnSeriesRetryClick" />
                    <ProgressRing x:Name="SeriesRing" Width="28" Height="28" HorizontalAlignment="Left" Visibility="Collapsed" />
                </StackPanel>

                <!-- Cast, directors, writers (built in code) -->
                <StackPanel x:Name="CastHost" Spacing="8" />

                <controls:RailView x:Name="RecommendedRail" Visibility="Collapsed" />
                <controls:RailView x:Name="RelatedRail" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Loading skeleton -->
        <StackPanel x:Name="Skeleton" Orientation="Horizontal" Spacing="22" Visibility="Visible">
            <Border Width="190" Height="285" CornerRadius="8" Background="{ThemeResource XmanaSurfaceBrush}" />
            <StackPanel Spacing="10" Margin="0,4,0,0">
                <Border Width="300" Height="30" CornerRadius="4" Background="{ThemeResource XmanaSurfaceBrush}" />
                <Border Width="200" Height="18" CornerRadius="4" Background="{ThemeResource XmanaSurfaceBrush}" />
                <Border Width="320" Height="90" CornerRadius="4" Background="{ThemeResource XmanaSurfaceBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Not found / error -->
        <StackPanel x:Name="MessagePanel"
                    Visibility="Collapsed"
                    MaxWidth="460"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="10">
            <TextBlock x:Name="MessageTitle" Style="{ThemeResource XmanaDisplayTextStyle}" FontSize="30" />
            <TextBlock x:Name="MessageBody" Style="{ThemeResource XmanaSecondaryTextStyle}" />
            <controls:ChoiceButton x:Name="RetryButton" Width="200" Margin="0,8,0,0" Click="OnRetryClick" />
        </StackPanel>
    </Grid>
</Page>
