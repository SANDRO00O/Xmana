<Page
    x:Class="Xmana.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls">

    <Grid>
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Style="{ThemeResource XmanaDisplayTextStyle}"
                       FontSize="30" />

            <controls:ChoiceButton x:Name="ClearButton"
                                   Grid.Row="1"
                                   Width="220"
                                   HorizontalAlignment="Left"
                                   Visibility="Collapsed"
                                   Click="OnClearClick" />

            <controls:ResultsView x:Name="Results" Grid.Row="2" />
        </Grid>

        <controls:ConfirmPanel x:Name="Confirm" />
    </Grid>
</Page>
