<Page
    x:Class="Xmana.App.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Milestone 1 scaffold for sections whose real content arrives in later milestones. -->
    <StackPanel VerticalAlignment="Center" Spacing="10">
        <TextBlock x:Name="TitleText" Style="{ThemeResource XmanaDisplayTextStyle}" />
        <TextBlock x:Name="BodyText" Style="{ThemeResource XmanaSecondaryTextStyle}" />
    </StackPanel>
</Page>
