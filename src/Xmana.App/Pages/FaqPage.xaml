<Page
    x:Class="Xmana.App.Pages.FaqPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Style="{ThemeResource XmanaDisplayTextStyle}"
                   FontSize="30" />

        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      IsTabStop="False"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      Visibility="Collapsed">
            <StackPanel x:Name="ItemsHost" Spacing="6" Margin="0,4,0,28" MaxWidth="560" HorizontalAlignment="Left" />
        </ScrollViewer>

        <ProgressRing x:Name="Ring" Grid.Row="1" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,16,0,0" IsActive="True" />

        <StackPanel x:Name="MessagePanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    MaxWidth="460"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="10">
            <TextBlock x:Name="MessageTitle" Style="{ThemeResource XmanaTitleTextStyle}" />
            <TextBlock x:Name="MessageBody" Style="{ThemeResource XmanaSecondaryTextStyle}" />
            <controls:ChoiceButton x:Name="RetryButton" Width="200" Margin="0,8,0,0" Click="OnRetryClick" />
        </StackPanel>
    </Grid>
</Page>
