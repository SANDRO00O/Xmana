<Page
    x:Class="Xmana.App.Pages.AdvancedSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
            <TextBlock x:Name="TitleText"
                       Style="{ThemeResource XmanaDisplayTextStyle}"
                       FontSize="30"
                       VerticalAlignment="Center" />
            <controls:ChoiceButton x:Name="EditButton" Width="190" Visibility="Collapsed" Click="OnEditClick" />
        </StackPanel>

        <!-- Filter form (shown until a search has run, or while editing) -->
        <ScrollViewer x:Name="FormScroller"
                      Grid.Row="1"
                      IsTabStop="False"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="10" Margin="0,4,0,28">
                <TextBox x:Name="TitleBox" InputScope="Search" AcceptsReturn="False" />
                <TextBox x:Name="StaffBox" InputScope="Search" AcceptsReturn="False" />
                <TextBlock x:Name="StaffNote" Style="{ThemeResource XmanaCaptionTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="YearFromBox" Width="130" InputScope="Number" MaxLength="4" />
                    <TextBox x:Name="YearToBox" Width="130" InputScope="Number" MaxLength="4" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="RatingBox" Width="170" />
                    <ComboBox x:Name="TypeBox" Width="170" />
                </StackPanel>
                <ComboBox x:Name="CategoryBox" Width="350" />
                <ComboBox x:Name="SortBox" Width="350" />
                <TextBlock x:Name="ValidationText"
                           Style="{ThemeResource XmanaBodyTextStyle}"
                           Foreground="{ThemeResource XmanaAccentBrush}"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <controls:ChoiceButton x:Name="ApplyButton" Width="170" Click="OnApplyClick" />
                    <controls:ChoiceButton x:Name="ResetButton" Width="150" Click="OnResetClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:ResultsView x:Name="Results" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</Page>
