<Page
    x:Class="Xmana.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls">

    <Grid>
        <ScrollViewer IsTabStop="False" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="10" Margin="0,0,0,36">
                <TextBlock x:Name="TitleText" Style="{ThemeResource XmanaDisplayTextStyle}" FontSize="30" />

                <!-- The groups below are built in code from one place so labels, values and focus keys stay consistent. -->
                <StackPanel x:Name="Host" Spacing="8" />
            </StackPanel>
        </ScrollViewer>

        <controls:ConfirmPanel x:Name="Confirm" />
    </Grid>
</Page>
