<Page
    x:Class="Xmana.App.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls"
    Background="Black"
    KeyDown="OnKeyDown">

    <Grid x:Name="Root" Background="Black">
        <!-- Video surface. The platform draws timed-text subtitles on it. -->
        <MediaPlayerElement x:Name="Video"
                            AreTransportControlsEnabled="False"
                            Stretch="Uniform" />

        <!-- Invisible focus target while the controls are hidden: A toggles play/pause, Left/Right seek. -->
        <Button x:Name="InputSink"
                Opacity="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsTabStop="True"
                UseSystemFocusVisuals="False"
                Click="OnSinkClick" />

        <!-- Readability scrims behind the controls -->
        <Grid x:Name="Scrims" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle VerticalAlignment="Top" Height="160">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle VerticalAlignment="Bottom" Height="240">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Controls, laid out inside the TV safe area -->
        <Grid x:Name="Overlay" Margin="{ThemeResource XmanaSafeAreaThickness}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="TopBar" Grid.Row="0" Spacing="2" Visibility="Collapsed">
                <TextBlock x:Name="TitleText"
                           Style="{ThemeResource XmanaTitleTextStyle}"
                           FontSize="26"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="EpisodeText" Style="{ThemeResource XmanaSecondaryTextStyle}" FontSize="16" Visibility="Collapsed" />
            </StackPanel>

            <!-- Loading / reconnecting / quality-change notice -->
            <StackPanel x:Name="StatusPanel"
                        Grid.Row="1"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing x:Name="StatusRing" Width="48" Height="48" IsActive="False" />
                <TextBlock x:Name="StatusText" Style="{ThemeResource XmanaBodyTextStyle}" TextAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="NoticeText"
                       Grid.Row="1"
                       Style="{ThemeResource XmanaCaptionTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,70,0,0"
                       Visibility="Collapsed" />

            <!-- Skip intro (only ever shown when verified timing data exists) -->
            <controls:ChoiceButton x:Name="SkipButton"
                                   Grid.Row="1"
                                   Width="190"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,20"
                                   Visibility="Collapsed"
                                   Click="OnSkipClick" />

            <!-- Next episode offer -->
            <Border x:Name="NextCard"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Padding="16"
                    CornerRadius="8"
                    Background="#E61B1B1B"
                    Visibility="Collapsed">
                <StackPanel Spacing="8" MinWidth="260">
                    <TextBlock x:Name="NextHeader" Style="{ThemeResource XmanaCaptionTextStyle}" />
                    <TextBlock x:Name="NextTitleText"
                               Style="{ThemeResource XmanaBodyTextStyle}"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NextCountdownText" Style="{ThemeResource XmanaSecondaryTextStyle}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ChoiceButton x:Name="PlayNowButton" Width="140" Click="OnPlayNowClick" />
                        <controls:ChoiceButton x:Name="CancelNextButton" Width="120" Click="OnCancelNextClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress and buttons -->
            <StackPanel x:Name="BottomBar" Grid.Row="2" Spacing="6" Visibility="Collapsed">
                <ProgressBar x:Name="SeekBar" Minimum="0" Maximum="1000" Height="6" IsIndeterminate="False" />
                <Grid>
                    <TextBlock x:Name="PositionText" Style="{ThemeResource XmanaCaptionTextStyle}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="RemainingText" Style="{ThemeResource XmanaCaptionTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel x:Name="ButtonsRow"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"
                            Visibility="Collapsed">
                    <controls:ChoiceButton x:Name="PreviousButton" Width="56" Click="OnPreviousClick" />
                    <controls:ChoiceButton x:Name="BackSeekButton" Width="56" Click="OnBackSeekClick" />
                    <controls:ChoiceButton x:Name="PlayPauseButton" Width="56" Click="OnPlayPauseClick" />
                    <controls:ChoiceButton x:Name="ForwardSeekButton" Width="56" Click="OnForwardSeekClick" />
                    <controls:ChoiceButton x:Name="NextButton" Width="56" Click="OnNextClick" />
                    <controls:ChoiceButton x:Name="OptionsButton" Width="56" Click="OnOptionsClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Resume / Start over -->
        <Grid x:Name="ResumePanel" Background="#CC000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460">
                <TextBlock x:Name="ResumeTitle" Style="{ThemeResource XmanaDisplayTextStyle}" FontSize="28" TextAlignment="Center" />
                <TextBlock x:Name="ResumeText" Style="{ThemeResource XmanaSecondaryTextStyle}" TextAlignment="Center" />
                <controls:ChoiceButton x:Name="ResumeButton" Width="260" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnResumeClick" />
                <controls:ChoiceButton x:Name="StartOverButton" Width="260" HorizontalAlignment="Center" Click="OnStartOverClick" />
            </StackPanel>
        </Grid>

        <!-- Failure -->
        <Grid x:Name="FailurePanel" Background="#E6000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
                <TextBlock x:Name="FailureTitle" Style="{ThemeResource XmanaDisplayTextStyle}" FontSize="28" TextAlignment="Center" />
                <TextBlock x:Name="FailureBody" Style="{ThemeResource XmanaSecondaryTextStyle}" TextAlignment="Center" />
                <controls:ChoiceButton x:Name="RetryButton" Width="260" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnRetryClick" />
                <controls:ChoiceButton x:Name="ChangeQualityButton" Width="260" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnChangeQualityClick" />
                <controls:ChoiceButton x:Name="ExitButton" Width="260" HorizontalAlignment="Center" Click="OnExitClick" />
            </StackPanel>
        </Grid>

        <!-- Options: quality, subtitles, autoplay, episodes -->
        <Grid x:Name="OptionsPanel" Background="#B3000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Right"
                    Width="420"
                    Background="#F2161616"
                    Padding="24,32,24,24">
                <ScrollViewer IsTabStop="False"
                              VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="OptionsHost" Spacing="6" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
