<Page
    x:Class="Xmana.App.Pages.LibraryListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Style="{ThemeResource XmanaDisplayTextStyle}"
                   FontSize="30" />

        <controls:ResultsView x:Name="Results" Grid.Row="1" />
    </Grid>
</Page>
