<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Xmana palette. Neutral dark, TV-safe (app surfaces stay within 16..235 per channel; only the
        brand splash/logo surfaces use pure black as specified). White marks FOCUS, the single
        restrained accent marks the ACTIVE/selected state.
    -->
    <Color x:Key="XmanaBackgroundColor">#FF101010</Color>
    <Color x:Key="XmanaSurfaceColor">#FF1B1B1B</Color>
    <Color x:Key="XmanaSurfaceRaisedColor">#FF262626</Color>
    <Color x:Key="XmanaDividerColor">#FF333333</Color>
    <Color x:Key="XmanaTextPrimaryColor">#FFEBEBEB</Color>
    <Color x:Key="XmanaTextSecondaryColor">#FFA6A6A6</Color>
    <Color x:Key="XmanaTextTertiaryColor">#FF7A7A7A</Color>
    <!-- Monochrome only: "accent" is a light neutral gray used for emphasis/active marks, never a hue. -->
    <Color x:Key="XmanaAccentColor">#FFD9D9D9</Color>
    <Color x:Key="XmanaFocusFillColor">#FFEBEBEB</Color>
    <Color x:Key="XmanaOnFocusColor">#FF101010</Color>
    <Color x:Key="XmanaBrandBlackColor">#FF000000</Color>

    <SolidColorBrush x:Key="XmanaBackgroundBrush" Color="{StaticResource XmanaBackgroundColor}" />
    <SolidColorBrush x:Key="XmanaSurfaceBrush" Color="{StaticResource XmanaSurfaceColor}" />
    <SolidColorBrush x:Key="XmanaSurfaceRaisedBrush" Color="{StaticResource XmanaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="XmanaDividerBrush" Color="{StaticResource XmanaDividerColor}" />
    <SolidColorBrush x:Key="XmanaTextPrimaryBrush" Color="{StaticResource XmanaTextPrimaryColor}" />
    <SolidColorBrush x:Key="XmanaTextSecondaryBrush" Color="{StaticResource XmanaTextSecondaryColor}" />
    <SolidColorBrush x:Key="XmanaTextTertiaryBrush" Color="{StaticResource XmanaTextTertiaryColor}" />
    <SolidColorBrush x:Key="XmanaAccentBrush" Color="{StaticResource XmanaAccentColor}" />
    <SolidColorBrush x:Key="XmanaFocusFillBrush" Color="{StaticResource XmanaFocusFillColor}" />
    <SolidColorBrush x:Key="XmanaOnFocusBrush" Color="{StaticResource XmanaOnFocusColor}" />
    <SolidColorBrush x:Key="XmanaBrandBlackBrush" Color="{StaticResource XmanaBrandBlackColor}" />
    <SolidColorBrush x:Key="XmanaLogoBrush" Color="{StaticResource XmanaTextPrimaryColor}" />

    <!-- TV safe area in effective pixels (XAML on Xbox renders at 200% => 960x540): 48 px sides, 27 px top/bottom. -->
    <Thickness x:Key="XmanaSafeAreaThickness">48,27,48,27</Thickness>

</ResourceDictionary>
