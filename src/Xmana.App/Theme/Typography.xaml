<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        One UI family with a fallback chain. Segoe UI covers Latin and Arabic (shaping, ligatures, marks);
        Tahoma/Arial are fallbacks. Verify on hardware; to bundle a dedicated Arabic+Latin font later,
        change only this one resource.
    -->
    <FontFamily x:Key="XmanaFontFamily">Segoe UI, Tahoma, Arial</FontFamily>

    <!-- Sizes are effective pixels (x2 on Xbox). Body >= 16 for couch reading distance. -->
    <x:Double x:Key="XmanaFontSizeDisplay">40</x:Double>
    <x:Double x:Key="XmanaFontSizeTitle">28</x:Double>
    <x:Double x:Key="XmanaFontSizeBody">18</x:Double>
    <x:Double x:Key="XmanaFontSizeCaption">15</x:Double>

    <Style x:Key="XmanaDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource XmanaFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource XmanaFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource XmanaTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="XmanaTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource XmanaFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource XmanaFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource XmanaTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="XmanaBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource XmanaFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource XmanaFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource XmanaTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="XmanaSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource XmanaBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource XmanaTextSecondaryBrush}" />
    </Style>

    <Style x:Key="XmanaCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource XmanaFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource XmanaFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource XmanaTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
