<UserControl
    x:Class="Xmana.App.Controls.HeroView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls"
    IsTabStop="False">

    <!-- Home hero: backdrop artwork, readable gradient, title/meta/description, Details and banner paging. -->
    <Grid Height="300" Background="{ThemeResource XmanaSurfaceBrush}">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0" />

        <Rectangle x:Name="HorizontalShade">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="HorizontalShadeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#F2101010" Offset="0" />
                    <GradientStop Color="#B3101010" Offset="0.55" />
                    <GradientStop Color="#00101010" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#00101010" Offset="0.55" />
                    <GradientStop Color="#E6101010" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="Info"
                    MaxWidth="400"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="24,0,24,22"
                    Spacing="6">
            <TextBlock x:Name="TitleText"
                       Style="{ThemeResource XmanaDisplayTextStyle}"
                       FontSize="30"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MetaText"
                       Style="{ThemeResource XmanaSecondaryTextStyle}"
                       FontSize="16"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DescriptionText"
                       Style="{ThemeResource XmanaSecondaryTextStyle}"
                       FontSize="15"
                       MaxLines="3"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <controls:ChoiceButton x:Name="PreviousButton" Width="46" Click="OnPreviousClick" />
                <controls:ChoiceButton x:Name="DetailsButton" Width="168" Click="OnDetailsClick" />
                <controls:ChoiceButton x:Name="NextButton" Width="46" Click="OnNextClick" />
                <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
