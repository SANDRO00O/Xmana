<UserControl
    x:Class="Xmana.App.Controls.ResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xmana.App.Controls"
    IsTabStop="False">

    <Grid>
        <!-- Results grid -->
        <ScrollViewer x:Name="Scroller"
                      IsTabStop="False"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="OnScrollerSizeChanged"
                      Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="OfflineNotice"
                           Style="{ThemeResource XmanaCaptionTextStyle}"
                           Margin="4,0,0,4"
                           Visibility="Collapsed" />
                <StackPanel x:Name="Rows" Margin="4,12,4,0" />
                <controls:ChoiceButton x:Name="LoadMoreRetryButton"
                                       Width="260"
                                       Margin="4,12,0,0"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed"
                                       Click="OnLoadMoreRetryClick" />
                <ProgressRing x:Name="MoreRing"
                              Width="28"
                              Height="28"
                              Margin="0,14,0,18"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed" />
                <Border Height="24" />
            </StackPanel>
        </ScrollViewer>

        <!-- Loading skeleton -->
        <StackPanel x:Name="Skeleton" Margin="4,12,4,0" Spacing="14" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="152" Height="228" CornerRadius="6" Background="{ThemeResource XmanaSurfaceBrush}" />
                <Border Width="152" Height="228" CornerRadius="6" Background="{ThemeResource XmanaSurfaceBrush}" />
                <Border Width="152" Height="228" CornerRadius="6" Background="{ThemeResource XmanaSurfaceBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Empty / error -->
        <StackPanel x:Name="MessagePanel"
                    Visibility="Collapsed"
                    MaxWidth="460"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="10">
            <TextBlock x:Name="MessageTitle" Style="{ThemeResource XmanaTitleTextStyle}" />
            <TextBlock x:Name="MessageBody" Style="{ThemeResource XmanaSecondaryTextStyle}" />
            <controls:ChoiceButton x:Name="RetryButton" Width="200" Margin="0,8,0,0" Click="OnRetryClick" />
        </StackPanel>
    </Grid>
</UserControl>
