<Application x:Class="Xmana.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="CanvasColor">#0B0D12</Color>
      <Color x:Key="SurfaceColor">#141923</Color>
      <Color x:Key="SurfaceRaisedColor">#1B2330</Color>
      <Color x:Key="AccentColor">#56D6C2</Color>
      <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="#8D99A8" />
      <Style TargetType="Button" x:Key="XmanaButton">
        <Setter Property="Background" Value="#1B2330" />
        <Setter Property="Foreground" Value="#F4F7FA" />
        <Setter Property="BorderBrush" Value="#2B3544" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
      </Style>
      <Style TargetType="TextBox" x:Key="XmanaTextBox">
        <Setter Property="Background" Value="#171E29" />
        <Setter Property="Foreground" Value="#F4F7FA" />
        <Setter Property="BorderBrush" Value="#354255" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="16,12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
