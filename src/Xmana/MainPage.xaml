<Page
    x:Class="Xmana.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource CanvasBrush}">
  <Grid x:Name="Root" Background="#0B0D12">
    <Grid.RowDefinitions>
      <RowDefinition Height="78"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="TopBar" Grid.Row="0" Background="#10151E" Padding="58,0,58,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="11">
        <Border Width="38" Height="38" CornerRadius="11" Background="#56D6C2">
          <TextBlock Text="X" Foreground="#081318" FontSize="25" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="XMANA" FontSize="23" FontWeight="Bold" CharacterSpacing="180"
                   VerticalAlignment="Center" Foreground="#F4F7FA" />
      </StackPanel>
      <StackPanel x:Name="NavigationTabs" Grid.Column="1" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <Button Content="Home" Tag="Home" Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
        <Button Content="Movies" Tag="Movies" Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
        <Button Content="Series" Tag="Series" Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
        <Button Content="Anime" Tag="Anime" Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
        <Button Content="Categories" Tag="Categories" Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
        <Button Content="Search" Tag="Search" Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
        <Button Content="My List" Tag="Library" Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
      </StackPanel>
      <Button x:Name="SettingsButton" Grid.Column="2" Content="Settings  ⚙" Tag="Settings"
              Style="{StaticResource XmanaButton}" Click="Navigation_Click" GotFocus="Navigation_GotFocus" />
    </Grid>
    <Grid Grid.Row="1" Margin="0">
      <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled">
        <StackPanel x:Name="PageContent" Padding="64,28,64,60" Spacing="30"
                    MaxWidth="1750" HorizontalAlignment="Center" />
      </ScrollViewer>
      <Border x:Name="BusyOverlay" Background="#B30B0D12" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
          <ProgressRing IsActive="True" Width="58" Height="58" Foreground="#56D6C2" />
          <TextBlock x:Name="BusyText" Text="Loading" FontSize="20" Foreground="#EAF0F5" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
